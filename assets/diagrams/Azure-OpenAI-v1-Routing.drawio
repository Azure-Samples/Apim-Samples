  <diagram id="aoai-v1-routing" name="Routing topology">
    <mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1440" pageHeight="1340" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Azure OpenAI v1 Routing" style="text;html=0;fontFamily=Arial;fontSize=30;fontStyle=1;fontColor=#172B4D;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1360" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="summary" value="Default: 4 APIs | 2 models | 4 pools | 6 backends | 3 Microsoft Foundry resources | 6 deployments" style="text;html=0;fontFamily=Arial;fontSize=20;fontColor=#334155;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="65" width="1360" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="path" value="Each subscription-protected v1 API: POST /chat/completions and POST /responses" style="text;html=0;fontFamily=Arial;fontSize=20;fontColor=#172B4D;align=left;verticalAlign=middle;" vertex="1" parent="1">
