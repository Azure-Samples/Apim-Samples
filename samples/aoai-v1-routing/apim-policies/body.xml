<policies>
    <!--
        Purpose:
          Read the model name from the v1 request body and send the request to that
          model's standard backend pool. This works for Chat Completions and Responses.

        Inputs:
          - Caller: an APIM subscription key accepted for this API, and a POST request
            to /chat/completions or /responses.
          - Body: a JSON object whose model field names the deployment to use,
            for example gpt-5-mini. If stream is supplied, it must be true or false.
            The model service checks the remaining fields, such as messages or input.
          - Resources: fragments and pools use the fixed aoai-v1-routing-1 prefix.
            The referenced fragments and pools must exist, and APIM's managed identity
            must have permission to call the model service.

        Variables:
          - model (string): the deployment name read from the body.
          - family (string): always standard; identifies which pool preferences to use.
          - backendPool (string): the pool name, built as aoai-v1-routing-1-model-family-pool.
          - scenario (string): always body; labels logs, not routing decisions.
            It is set again in on-error so failures keep the same label.
          - errorCode (string): starts empty, meaning no local error has been found.
          - errorStatus (int): starts at 404; used only when rejecting a request locally,
            not as the status for a successful request.
          - bodySelection (JObject): compact model/errorCode/errorStatus result from
            body-model's single parsing and validation block; not the full request body.
          - bodyValidation (string): empty if the body check passes, otherwise
            InvalidRequest or ModelNotAvailable; set by the body-model fragment.
          - routePhase (string): resolve while selecting the pool, then resolved.
            This helps avoid reporting later failures as a missing route.
          - upstreamCode (string): an approved error code from a failed model-service response.
          - gatewayCode (string), gatewayStatus (int) and safeReason (string):
            the error category, HTTP status and short diagnostic reason set if APIM fails.

        Outputs:
          - Forward the unchanged body to the same v1 operation on the selected backend.
            Drop query parameters and caller credential/routing headers; authenticate
            to the model service with APIM's managed identity instead.
          - Make one attempt with a 60-second timeout and no retries; do not buffer
            the response. Successful response bodies and HTTP statuses are unchanged.
          - Add x-routing-request-id for troubleshooting and x-routing-pool plus
            x-routing-backend-host (resolved hostname, without path or credentials) after a
            backend response. Failed responses use fixed messages and emit error traces.
          - Invalid input returns 400 InvalidRequest or 404 ModelNotAvailable.
            An invalid pool name or a failure attributed to pool selection returns
            404 model_not_available; other failures must not be called a missing route.
          - Inactive pools and connection failures return 503 UpstreamUnavailable; backend timeouts return
            504 UpstreamTimeout; other APIM failures return 500 GatewayError.
            Model-service HTTP errors keep their original status.
          - Local rejection stops processing before outbound runs; its response still
            includes the request ID, and its error trace is written before returning.
    -->
    <inbound>
        <base />
        <set-variable name="scenario" value="body" />
        <set-variable name="errorCode" value="" />
        <set-variable name="errorStatus" value="@(404)" />
        <set-variable name="family" value="standard" />

        <include-fragment fragment-id="aoai-v1-routing-1-body-model" />
        <include-fragment fragment-id="aoai-v1-routing-1-route-request" />
    </inbound>
    <backend>
        <forward-request timeout="60" buffer-response="false" fail-on-error-status-code="false" />
    </backend>
    <outbound>
        <base />
        <include-fragment fragment-id="aoai-v1-routing-1-safe-response" />
    </outbound>
    <on-error>
        <set-variable name="scenario" value="body" />
        <include-fragment fragment-id="aoai-v1-routing-1-safe-error" />
    </on-error>
</policies>
