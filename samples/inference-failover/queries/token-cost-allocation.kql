// Estimates token cost by model, Azure OpenAI API surface, and delivery mode.
// Rates are user-supplied estimates per 1,000 tokens; confirm current contract pricing.
//
// Parameters (prepend as KQL 'let' bindings before running):
//   let timeWindow = 1h;
//   let gpt51PromptRate = 0.0;
//   let gpt51CompletionRate = 0.0;
//   let gpt41MiniPromptRate = 0.0;
//   let gpt41MiniCompletionRate = 0.0;
//
let routes = materialize(ApiManagementGatewayLogs
| where TimeGenerated > ago(timeWindow)
| where ApiId in~ ('inference-gpt-5-1', 'inference-gpt-4-1-mini')
| project CorrelationId, ApiId, OperationId, BackendId, BackendUrl);
ApiManagementGatewayLlmLog
| where TimeGenerated > ago(timeWindow)
| where TotalTokens > 0 and isnotempty(ModelName)
| project CorrelationId, ModelName, IsStreamCompletion, PromptTokens, CompletionTokens, TotalTokens
| summarize
	IsStreamCompletion = take_any(IsStreamCompletion),
	PromptTokens = sum(PromptTokens),
	CompletionTokens = sum(CompletionTokens),
	TotalTokens = sum(TotalTokens)
	by CorrelationId, ModelName
| join kind=inner routes on CorrelationId
| extend ApiSurface = iff(OperationId contains 'responses', 'Responses', 'Chat Completions')
| extend DeliveryMode = iff(IsStreamCompletion == true, 'Streaming', 'Non-Streaming')
| extend AOAIInstance = iff(isnotempty(BackendUrl), tostring(split(tostring(parse_url(BackendUrl).Host), '.')[0]), '')
| extend Backend = case(isnotempty(BackendUrl), BackendUrl, isnotempty(BackendId), BackendId, '(backend not recorded)')
| summarize
	Requests = count(),
	PromptTokens = sum(PromptTokens),
	CompletionTokens = sum(CompletionTokens),
	TotalTokens = sum(TotalTokens)
	by ApiId, AOAIInstance, Backend, ModelName, ApiSurface, DeliveryMode
| extend
	PromptRate = case(ModelName startswith 'gpt-5.1', gpt51PromptRate, ModelName startswith 'gpt-4.1-mini', gpt41MiniPromptRate, 0.0),
	CompletionRate = case(ModelName startswith 'gpt-5.1', gpt51CompletionRate, ModelName startswith 'gpt-4.1-mini', gpt41MiniCompletionRate, 0.0)
| extend
	PromptCost = round(PromptTokens * PromptRate / 1000.0, 6),
	CompletionCost = round(CompletionTokens * CompletionRate / 1000.0, 6)
| extend TotalCost = round(PromptCost + CompletionCost, 6)
| extend RateStatus = iff(PromptRate > 0.0 or CompletionRate > 0.0, 'Configured', 'Configure model rates')
| order by TotalCost desc, ApiId asc, ModelName asc
